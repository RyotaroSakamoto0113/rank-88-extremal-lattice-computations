need(b,s)={if(!b,error(s))};
read(Str(INPUTS,"/ambient.gp"));read(WITNESS_FILE);
B=W1[4];expected_class=W1[2];need(W1[1]==48 && W1[3]==1,"probe witness");
need(matsize(B)==[22,8]&&denominator(B)==1&&matrank(B)==8,"integer rank eight basis");
action=matinverseimage(B,W*B);need(denominator(action)==1 && B*action==W*B,"O stability");
sn=matsnf(B);need(vecmax(abs(sn))==1,"saturated witness");
Q=B~*G*B;need(matdet(Q)==23^4*48^2,"determinant48");
pol=t^2-t+6;bnf=bnfinit(pol,1);nf=bnf.nf;al=Mod(t,pol);
U=matrix(22,0);V=matrix(22,0);
for(j=1,8,if(matrank(concat(V,Mat(B[,j])))>matsize(V)[2],U=concat(U,Mat(B[,j]));V=concat(U,W*U)));
need(matsize(U)==[22,4]&&matsize(V)==[22,8],"F basis");
C=matinverseimage(V,B);need(V*C==B,"rational coordinate identity");
CF=matrix(4,8,i,j,C[i,j]+al*C[i+4,j]);
PN=nfhnf(nf,[CF,vector(8,i,1)]);
detideal=1;for(i=1,4,detideal=idealmul(nf,detideal,PN[2][i]));
pideal=idealhnf(nf,2,al);pclass=bnfisprincipal(bnf,pideal,0)[1];
cls=lift(Mod(bnfisprincipal(bnf,detideal,0)[1],3)/Mod(pclass,3));
need(cls==expected_class,"independent Steinitz class");
H=matrix(4,4,i,j,((11*(U[,i]~*G*U[,j])+(W*U[,i])~*G*U[,j])/23)+al*(((U[,i]~*G*U[,j])-2*(W*U[,i])~*G*U[,j])/23));
hermdet=lift(matdet(H))*nfeltnorm(nf,matdet(PN[1]))*idealnorm(nf,detideal);
need(hermdet==48,"pseudo-basis determinant independent of trace formula");
rows(A)=vector(matsize(A)[1],i,Vec(A[i,]));
write(OUT_JSON,Str("{\"expected_determinant\":48,\"steinitz_class_mod3\":",cls,",\"saturated\":true,\"basis\":",rows(B),",\"omega_action\":",rows(action),",\"trace_gram\":",rows(Q),",\"ambient_trace_gram\":",rows(G),",\"ambient_omega_action\":",rows(W),"}"));
write(OUT_GP,"FIELD_POLYNOMIAL=",pol,";F_BASIS=",U,";COORDINATES=",CF,";PSEUDOBASIS=",PN,";HERMITIAN_F_BASIS=",H,";STEINITZ_IDEAL=",detideal,";CLASS=",cls,";DETERMINANT=",hermdet,";");
print("WITNESS_VERIFIED determinant=",hermdet," Steinitz_class=",cls," trace_determinant=",matdet(Q));
quit;
