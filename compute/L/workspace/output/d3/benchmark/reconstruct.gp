read("rank88_exact_data.gp");
gettime();
phi=polcyclo(23); e=Mod(x,phi); t=e+e^-1;
alpha=1/((2-t)^5*A23(t));
tr(v)={my(p=lift(v));23*polcoef(p,0)-subst(p,x,1)};
B=vector(22,i,if(i==1,47,e^(i-1)-lift(Mod(21,47)^(i-1))));
G=matrix(22,22,i,j,tr(alpha*B[i]*subst(lift(B[j]),x,e^-1)));
if(denominator(G)!=1,error("Nonintegral Gram"));
U=qflllgram(G); G=U~*G*U; B=B*U;
w=1+sum(k=1,22,if(kronecker(k,23)==1,e^k,0));
BC=matrix(22,22,i,j,polcoef(lift(B[j]),i-1));
W=BC^-1*matrix(22,22,i,j,polcoef(lift(w*B[j]),i-1));
E=BC^-1*matrix(22,22,i,j,polcoef(lift(e*B[j]),i-1));
print("reconstruction_ms=",gettime()," determinant=",matdet(G)," expected=",23^11);
print("diag=",vector(22,i,G[i,i]));
print("omega_poly=",W^2-W+6," eta_isometry=",E~*G*E==G);
write("output/d3/benchmark/ambient.gp",Str("G=",G,";W=",W,";E=",E,";B=",B,";"));
gettime(); sv=qfminim(G,16,,2); print("shell_ms=",gettime()," vectors=",sv[1]);
V=sv[3];
print("norms=",vecsort(vector(matsize(V)[2],i,(V[,i]~*G*V[,i]))));
write("output/d3/benchmark/shortvec.gp",Str("V=",V,";"));
quit;
