default(nbthreads,1);
default(parisize,512000000);
need(b,s)={if(!b,error(s))};
OUT="output/perfect_reaudit/input";
read(Str(OUT,"/source_rank88_exact_data.gp"));
read(Str(OUT,"/source_J_ambient.gp"));
cf(c)=subst(lift(c),y,1-w);
ce(c)=sum(k=0,3,cf(polcoef(lift(c),k,x))*z^-k);
te(c)=5*polcoef(lift(c),0,x)-subst(lift(c),x,1);
fa(c)=polcoef(lift(c),0,y);
fb(c)=polcoef(lift(c),1,y);
flat(name,A)={my(f=fileopen(Str(OUT,"/",name,".txt"),"w"),sz=matsize(A));filewrite(f,Str(sz[1]," ",sz[2]));for(i=1,sz[1],filewrite(f,strjoin(vector(sz[2],j,Str(A[i,j]))," ")));fileclose(f)};
main()={
 my(start=getwalltime(),t0,phi23=polcyclo(23),eta=Mod(x,phi23),t,etaW,BC,Jweight,Gdirect,Wdirect,M23base,
  C,Ca,Cb,delta4,H4,Hexpected,H4a,H4b,Z5,A5,A5a,A5b,JH0,JH1,G88,M5,M23,M115,G8,cp,X,fd,pi43,pi47);
 t=eta+eta^-1;Jweight=1/((2-t)^5*A23(t));etaW=1+sum(k=1,22,if(kronecker(k,23)==1,eta^k,0));
 BC=matrix(22,22,i,j,polcoef(lift(B[j]),i-1,x));need(denominator(BC)==1&&abs(matdet(BC))==47,"actual norm47 ideal basis");
 for(j=1,22,need(subst(lift(B[j]),x,Mod(21,47))==0,"ideal47 membership"));
 Gdirect=matrix(22,22,i,j,my(v=lift(Jweight*B[i]*subst(lift(B[j]),x,eta^-1)));23*polcoef(v,0,x)-subst(v,x,1));
 Wdirect=BC^-1*matrix(22,22,i,j,polcoef(lift(etaW*B[j]),i-1,x));M23base=BC^-1*matrix(22,22,i,j,polcoef(lift(eta*B[j]),i-1,x));
 need(Gdirect==G&&Wdirect==W&&M23base==E,"original J field arithmetic matches saved G,W,E");
 need(W^2-W+6*matid(22)==0&&W~*G==G*(matid(22)-W),"J omega action");
 need(denominator(M23base)==1&&M23base^23==matid(22)&&M23base~*G*M23base==G,"J zeta23 integral isometry");
 JH0=(11*G+W~*G)/23;JH1=(G-2*W~*G)/23;need(denominator(JH0)==1&&denominator(JH1)==1,"J Hermitian coefficients integral");
 print("ORIGINAL_J_MS=",getwalltime()-start);t0=getwalltime();
 w=Mod(y,y^2-y+6);d=2*w-1;z=Mod(x,polcyclo(5));
 P=[1-w+w*z-2*z^3,-2-2*z-3*z^3,1-3*z-(1+w)*z^3,-w-z^2-(1+w)*z^3];
 C=matrix(4,4,i,j,polcoef(lift(P[j]),i-1,x));need(matdet(C)==1,"TeX p basis is O unimodular");
 delta4=(11*d*(z-z^-1)*(z+z^-1)-2*d*(z-z^-1)-115*(z+z^-1)+115)/2;need(ce(delta4)==delta4,"delta4 real");
 H4=matrix(4,4,i,j,te(P[i]*ce(P[j])/delta4));Hexpected=[1,0,4/d,w/d;0,1,(w-1)/d,4/d;-4/d,w/d,1,0;(w-1)/d,-4/d,0,1];
 need(H4==Hexpected&&matdet(H4)==1/529,"TeX h4 Gram derived from delta4");
 Z5=matrix(4,4,i,j,polcoef(lift(z*z^(j-1)),i-1,x));A5=C^-1*Z5*C;
 A5a=matrix(4,4,i,j,fa(A5[i,j]));A5b=matrix(4,4,i,j,fb(A5[i,j]));need(denominator(A5a)==1&&denominator(A5b)==1&&A5^5==matid(4),"TeX zeta5 integral action");
 H4a=matrix(4,4,i,j,fa(H4[i,j]));H4b=matrix(4,4,i,j,fb(H4[i,j]));
 G8=matrix(8,8,i,j,my(h=if(i%2,w^0,w)*H4[(i+1)\2,(j+1)\2]*if(j%2,w^0,1-w));2*fa(h)+fb(h));
 need(denominator(G8)==1&&G8==G8~&&matdet(G8)==1,"E trace Gram unimodular");for(i=1,8,need(G8[i,i]%2==0&&matdet(G8[1..i,1..i])>0,"E trace even positive"));
 print("ORIGINAL_E_MS=",getwalltime()-t0);t0=getwalltime();
 G88=matrix(88,88,i,j,my(a=(i-1)\22+1,b=(j-1)\22+1,u=(i-1)%22+1,v=(j-1)%22+1);(2*H4a[a,b]+H4b[a,b])*JH0[u,v]+(H4a[a,b]-11*H4b[a,b])*JH1[u,v]);
 M5=matrix(88,88,i,j,my(a=(i-1)\22+1,b=(j-1)\22+1,u=(i-1)%22+1,v=(j-1)%22+1);A5a[a,b]*(u==v)+A5b[a,b]*W[u,v]);
 M23=matrix(88,88,i,j,if((i-1)\22==(j-1)\22,M23base[(i-1)%22+1,(j-1)%22+1],0));M115=M5*M23;
 need(denominator(G88)==1&&G88==G88~&&matdet(G88)==1,"tensor Gram integral symmetric unimodular");for(i=1,88,need(G88[i,i]%2==0&&matdet(G88[1..i,1..i])>0,"tensor Gram even positive"));
 need(M5^5==matid(88)&&M23^23==matid(88)&&M5!=matid(88)&&M23!=matid(88)&&M5*M23==M23*M5,"commuting exact prime orders");
 need(M5~*G88*M5==G88&&M23~*G88*M23==G88,"tensor isometries");cp=charpoly(M115);need(cp==polcyclo(115),"primitive115 cyclotomic characteristic polynomial");
 flat("G88",G88);flat("M5",M5);flat("M23",M23);flat("M115",M115);flat("J_G",G);flat("J_W",W);flat("J_M23",M23base);flat("J_basis_power",BC);flat("E_G8",G8);flat("E_P_a",matrix(4,4,i,j,fa(C[i,j])));flat("E_P_b",matrix(4,4,i,j,fb(C[i,j])));flat("E_M5_a",A5a);flat("E_M5_b",A5b);flat("E_H4_a23",23*H4a);flat("E_H4_b23",23*H4b);flat("J_H0",JH0);flat("J_H1",JH1);
 fd=fileopen(Str(OUT,"/tensor_input.gp"),"w");filewrite(fd,Str("G88=",G88,";M5=",M5,";M23=",M23,";M115=",M115,";"));fileclose(fd);
 fd=fileopen(Str(OUT,"/field_derivation.gp"),"w");filewrite(fd,Str("E_BASIS=",C,";E_DELTA4=",delta4,";E_H4=",H4,";E_MULTIPLICATION5=",A5,";CYCLOTOMIC_CHARACTERISTIC=",cp,";"));fileclose(fd);
 pi43=subst(phi23,x,Mod(21,43));pi47=subst(phi23,x,Mod(21,47));need(pi43==22&&pi47==0,"TeX43 typo check");
 print("TENSOR_BUILD_VERIFY_EXPORT_MS=",getwalltime()-t0);print("TENSOR_INPUT_VERIFIED dimension88 determinant1 positive_even1 order5_23_commute1 charpolyPhi115_1 total_ms=",getwalltime()-start);
};
main();quit;
