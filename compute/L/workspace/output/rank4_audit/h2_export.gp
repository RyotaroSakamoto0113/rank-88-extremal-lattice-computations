default(parisizemax,1000000000);
read("output/d3/benchmark/ambient.gp");
assert(b,s)={if(!b,print("FAIL: ",s);quit(1))};
exportGW(path,G0,W0)={my(n=matsize(G0)[1],fd=fileopen(path,"w"));filewrite(fd,Str(n," 18"));for(i=1,n,filewrite(fd,strjoin(vector(n,j,Str(G0[i,j]))," ")));for(i=1,n,filewrite(fd,strjoin(vector(n,j,Str(W0[i,j]))," ")));fileclose(fd)};
assert(W^2-W+6*matid(22)==0,"omega polynomial");
assert(W~*G*W==6*G,"omega norm");
assert(W~*G+G*W==G,"omega conjugation");
assert(denominator(G)==1 && denominator(W)==1,"integrality");
assert(denominator((12*G-G*W)/23)==1 && denominator((2*G*W-G)/23)==1,"M Hermitian integrality");
exportGW("output/rank4_audit/h2_M_input.txt",G,W);
read("output/direct_extremality/countermodel_data.gp");
d=2*w-1;
ctr(z)=subst(lift(z),x,1-w);
tr(z)=polcoef(lift(z+ctr(z)),0);
HN=H~; Uold=Pbasis;
GN=matrix(8,8,i,j,tr(HN[(i-1)%4+1,(j-1)%4+1]*if(i>4,w,1)*if(j>4,1-w,1)));
exportGW("output/rank4_audit/h2_N_input.txt",GN,WZ);
read("output/direct_extremality/basis_search_target_result.gp");
A=U^-1*Uold;
HXN=A*HN*ctr(A~);
D=[d,0,-4,w-1;0,d,w,-4;0,0,1,0;0,0,0,1];
HYN=D*HXN*ctr(D~);
assert(trace(HYN)==46 && matdet(HXN)==25,"countermodel target basis");
f=fileopen("output/rank4_audit/h2_N_target.gp","w");
filewrite(f,Str("w=",w,";d=",d,";HXN=",HXN,";HYN=",HYN,";"));
fileclose(f);
print("EXPORTED_M_AND_N");
quit;
