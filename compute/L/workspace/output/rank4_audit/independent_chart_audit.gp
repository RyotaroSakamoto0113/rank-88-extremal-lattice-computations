default(parisize,400000000);
w=Mod(x,x^2-x+6);d=2*w-1;
barf(z)=subst(lift(z),x,1-w);
trf(z)=polcoef(lift(z+barf(z)),0);
assert(b,s)={if(!b,error(s))};
tracegram(H)={my(n=matsize(H)[1]);matrix(2*n,2*n,i,j,trf(H[(i-1)%n+1,(j-1)%n+1]*if(i>n,w,1)*if(j>n,1-w,1)))};
rowkey(v)={my(a=vector(8,i,polcoef(lift(v[1+(i-1)%4]),(i-1)\4)));if(lex(a,-a)<0,a,-a)};
chartkey(R)={vecsort(vector(4,i,rowkey(R[i,])))};
projectivekey(v)={my(j=1);while(v[j]==0,j++);rowkey(v/v[j])};
matkey(U)=vector(32,i,polcoef(lift(U[(i-1)%4+1,((i-1)\4)%4+1]),(i-1)\16));
main()={
my(start=getabstime(),C=[4,w;w-1,4]/d,H,D,B,V,VF,J,n,HH,aut=List(),RR=List(),keys=List(),mono=List(),rootsfirst=vector(240));
H=matconcat([matid(2),C;barf(C~),matid(2)]);
D=[d,0,-4,w-1;0,d,w,-4;0,0,1,0;0,0,0,1];
assert(D~*barf(D)==23*H,"square completion");
B=tracegram(H);
assert(denominator(B)==1 && matdet(B)==1,"E8 integral unimodular");
assert(vector(8,i,B[i,i]%2)==vector(8),"E8 even");
V=qfminim(B,2,,2)[3];V=concat(V,-V);n=matsize(V)[2];assert(n==240,"240 roots");
VF=V[1..4,]+w*V[5..8,];HH=VF~*H*barf(VF);
for(i=1,n,assert(HH[i,i]==1,"root norm");for(j=1,n,if(HH[i,j]!=0,next);for(k=1,n,if(HH[i,k]!=H[1,3] || HH[j,k]!=H[2,3],next);for(l=1,n,if(HH[i,l]!=H[1,4] || HH[j,l]!=H[2,4] || HH[k,l]!=0,next);my(U=matrix(4,4,a,b,VF[a,[i,j,k,l][b]]),R);assert(U~*H*barf(U)==H,"source automorphism");assert(matdet(U)*barf(matdet(U))==1,"O-unimodular source");rootsfirst[i]++;listput(aut,U);R=D*U^-1*D^-1;assert(R*barf(R~)==matid(4),"unitary chart");listput(RR,R);listput(keys,chartkey(R));my(m=1);for(a=1,4,my(nz=0);for(b=1,4,if(R[a,b]!=0,if(R[a,b]!=1 && R[a,b]!=-1,m=0);nz++));if(nz!=1,m=0));if(m,listput(mono,R))))));
assert(#aut==240 && rootsfirst==vector(240,i,1),"regular action on roots");
assert(#mono==8,"signed monomial subgroup");
my(G=Vec(aut),GS=Set(vector(#aut,i,matkey(aut[i]))));assert(#GS==240,"distinct source automorphisms");for(i=1,#G,for(j=1,#G,assert(setsearch(GS,matkey(G[i]*G[j]))>0,"group closure")));
my(K=Set(Vec(keys)),directions=Set(vector(#RR*4,i,rowkey(RR[(i-1)\4+1][(i-1)%4+1,]))),blocks=List(),pairs=List(),triples=List(),perms=List());
assert(#K==30 && #directions==120,"30 charts /120 directions");
my(plines=Set(vector(#RR*4,i,projectivekey(RR[(i-1)\4+1][(i-1)%4+1,]))));assert(#plines==120,"120 genuinely F-projective directions");
for(i=1,#RR,my(r=vector(4,j,rowkey(RR[i][j,])));for(a=1,4,for(b=a+1,4,listput(pairs,vecsort([r[a],r[b]]));for(c=b+1,4,listput(triples,vecsort([r[a],r[b],r[c]])))));listput(blocks,vecsort([r[1],r[2]]));listput(blocks,vecsort([r[3],r[4]])));
for(i=1,#mono,listput(perms,vector(4,a,sum(b=1,4,if(mono[i][a,b]!=0,b,0)))));
assert(#Set(Vec(pairs))==180 && #Set(Vec(triples))==120 && #Set(Vec(blocks))==60,"pair/triple/block counts");
assert(#Set(Vec(perms))==4,"Klein four permutation action");
print("aut=",#G," monomial=",#mono," charts=",#K," directions=",#directions," pairs=",#Set(Vec(pairs))," triples=",#Set(Vec(triples))," blocks=",#Set(Vec(blocks)));
print("permutations=",Set(Vec(perms)));
my(L=[-8,1,2,0;3,1,0,-6;1,0,4,1-w;0,1,-w,4]/d,F=L*D);
assert(F==[-8,1,2-3*w,-4;3,1,w,1+w;1,0,0,0;0,1,0,0],"four integral triple extension identities");
print("triple extension coefficient rows=",F);
my(fd=fileopen("output/rank4_audit/independent_charts.gp","w"));filewrite(fd,Str("H=",H,";D=",D,";aut=",Vec(aut),";RR=",Vec(RR),";B=",B,";roots=",V,";"));fileclose(fd);
print("INDEPENDENT_CHART_AUDIT_PASSED wall_ms=",getabstime()-start);
};
main();quit;
